# Copiar como .env.test y usar una base PostgreSQL exclusiva para pruebas.
NODE_ENV=test
PORT=3001
APP_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://user:password@localhost:5432/sistema_auth_starter_test
JWT_ACCESS_SECRET=test-access-secret-change-me-12345678901234567890
JWT_REFRESH_SECRET=test-refresh-secret-change-me-12345678901234567890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
LOG_LEVEL=error
REDIS_URL=
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
